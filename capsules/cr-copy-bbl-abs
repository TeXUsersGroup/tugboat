#!/bin/sh
# $Id$
# Copy helper (bbl.tex, abs.tex, .aux, .bib) files for Crossref. Public domain.
# 
# As a first step toward preparing a Crossref upload (see
# ltx2crossrefxml, crossref/README, etc.), we copy all helper files for
# a given issue $1 to the temporary holding directory $2.
# 
# These so-called helper files include bbl.tex and abs.tex (created by
# hand), and *.aux and *.bib (as written). Any or all may not exist for
# a given article, but there will (presumably) be at least one of each
# type for an entire issue. (If that assumption fails, have to change
# the checks below not to exist.)

# We're going to assume there are no spaces in filenames,
# cp supports -p, and other such non-portabilities.
cp="cp -pf" # -v

if test $# -ne 2; then
  echo "Usage: $0 CAPSULE.txt OUTPUTDIR" >&2
  echo "(see source for info)" >&2
  exit 1
fi

if test ! -s "$1"; then
  echo "$0: capsule file does not exist or is empty: $1" >&2
  exit 1
fi
capsule=$1

if test ! -d "$2"; then
  echo "$0: output not a directory: $2" >&2
  exit 1
fi
outdir=$2

# Extract the volume, issue, and sequence number from the \issue line in
# the capsule file. We don't use anything else.
# \issue{41}{3}{129}{2020}{}{}
set - `grep '^\\\\issue' "$capsule" | sed -n 's/[{}]/ /gp'`
#
volno=$2
issno=$3
seqno=$4

# Our convention is that the issue sources are in ~tubprod/VV-N/*,
# while this script is in ~tubprod/svn/capsules (an svn checkout).
# Use a relative path instead of hardwiring ~tubprod, but assume
# that layout.
# 
mydir=`cd \`dirname "$0"\` && pwd`  # .../svn/capsules
issdir=`cd "$mydir/../../$volno-$issno" && pwd`

if test ! -d "$issdir"; then
  echo "$0: could not find issue directory: $issdir" >&2
  echo "$0: (from volno=$volno, issno=$issno, seqno=$seqno)" >&2
  exit 1
fi

bbl_count=`ls -1 $issdir/*/bbl.tex 2>/dev/null | wc -l`
if test $bbl_count -eq 0; then
  echo "$0: no bbl.tex files found under: $issdir" >&2
  exit 1
fi
#
abs_count=`ls -1 $issdir/*/abs.tex 2>/dev/null | wc -l`
if test $abs_count -eq 0; then
  echo "$0: no abs.tex files found under: $issdir" >&2
  exit 1
fi
#
aux_count=`ls -1 $issdir/*/*.aux 2>/dev/null | wc -l`
if test $aux_count -eq 0; then
  echo "$0: no aux files found under: $issdir" >&2
  exit 1
fi
#
bib_count=`ls -1 $issdir/*/*.bib 2>/dev/null | wc -l`
if test $bib_count -eq 0; then
  echo "$0: no bib files found under: $issdir" >&2
  exit 1
fi

# We intentionally do not erase existing files or move them aside;
# another level (namely the cr-do-issue script) does that.

# Separate the bbl used for the doi stuff from the one used by TeX,
# since it often needs editing; that is, we manually copy or create
# bbl.tex in each item directory, and then save it as tbNNNIDENT.bbl
# when copying into our output directory. ltx2crossrefxml looks for it
# with the latter name.
#
for b in $issdir/*/bbl.tex; do
  ident=`basename \`dirname "$b"\``
  dest=$outdir/tb${seqno}${ident}.bbl
  $cp "$b" "$dest" || exit 1
done  

# Similarly for abstracts.
# 
for a in $issdir/*/abs.tex; do
  ident=`basename \`dirname "$a"\``
  dest=$outdir/tb${seqno}${ident}.abs
  $cp "$a" "$dest" || exit 1
done  

# Similarly for the aux files.
# 
for a in $issdir/*/*.aux; do
  ident=`basename \`dirname "$a"\``
  dest=$outdir/tb${seqno}${ident}.aux
  $cp "$a" "$dest" || exit 1
done  

# But for the bib files, preserve the original names,
#  since the aux file refers to them.
# And since those names are random, copy them all into a subdir bib/
#  instead of cluttering up the main $outdir. The Makefile sets
#  TEXMFDOTDIR to find them there.
# Also, exclude save*.bib, orig*.bib, etc., since those are backup files we
#  create during editing.
# Also, if there are any duplicate names, quit. Processing
#  can't succeed if there are two bib files by the same name,
#  since we're copying everything into a single working directory.
# 
for bib in $issdir/*/*.bib; do
  bib_basename=`basename "$bib"`
  echo "$bib_basename" \
    | egrep '^(auth|bb\.|orig|preauth|printed|save|x\.)' >/dev/null \
    && continue
  dest=$outdir/bib/$bib_basename
  if test -e "$dest"; then
    echo "$0: bib file already exists: $dest" >&2
    echo "$0:      trying to copy new: $bib" >&2
    echo "$0: this must be rectified to continue, goodbye." >&2
    exit 1
  fi
  test -d "$outdir"/bib || mkdir "$outdir"/bib
  $cp "$bib" "$dest" || exit 1
done  

echo "$0: $bbl_count bbl, $abs_count abs, $aux_count aux, $bib_count bib copied: $outdir"
exit 0
