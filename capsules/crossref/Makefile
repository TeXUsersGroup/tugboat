# $Id$
# Public domain.
# See the README here for the general story on our doi support.

# We want to use the development version of ltx2crossrefxml, e.g.,
# a symlink to /home/.../crossrefware/ltx2crossrefxml.pl
# in a crossrefware checkout. It's not unlikely that any given issue of
# TUB will require updates to crossrefware or bibtexperllibs.
ltx2crossrefxml = $(ltx2env) ./ltx2crossrefxml
#
tub_cfg = ltx2crossrefxml-tugboat.cfg

# ltx2crossrefxml uses kpsewhich to look up bib files; we copy the bib
# files into the dir*/ subdirs, but run ltx2crossrefxml from this parent
# dir, so by default they wouldn't be found. Web2c's texmf.cnf has a
# variable TEXMFDOTDIR to (more or less) allow pretending that the
# current directory is something else:
ltx2env = env TEXMFDOTDIR=dir2.process/bib

# We will read all the rpi files generated by captub, which we run one
# issue at a time. ltx2crossrefxml automatically reads the companion
# .bbl and .aux and .bib files.
rpi_input = dir2.process/*.rpi
#rpi_input = dir2.process/tb127wermuth-ragged.rpi # debugging one article
#
# The output file we will eventually upload.
xml_output = dir2.process/issue.xml
#
# When uploading corrections:
#xml_output = dir3.uploaded/tb132/issue-corr2.xml

# All the arguments we pass.
ltx2crossrefxml_args = -c $(tub_cfg) $(rpi_input) --rpi-is-xml -o $(xml_output)
#ltx2crossrefxml_args += --debug

# the "issue" target is used by cr-do-issue.
$(xml_output) issue: $(rpi_input) $(tub_cfg) force
	$(ltx2crossrefxml) $(ltx2crossrefxml_args) \
	  || { rm -f $(xml_output); exit 1; }
	xmllint --noout $(xml_output) # basic syntax check
#sed '1,/<titles>/d' $(xml_output) # omit top boilerplate
# check basics:
#egrep '(name|organization|title)>' $(xml_output)
# see citation text:
#grep -A1 '<citation' $(xml_output) | grep -v '^--$$' | cut -c 6-
#
# Fail if untranslated stuff in the output:
# - The translations work hard to specifically never output a \.
# - Two $'s is assumed to be math mode (not handled, so the $ chars should
#   be deleted). A single $ is sometimes used as a price in USD.
#   (Reminder: make needs the doubled $$ to pass a single $).
# - " TUB " is \TUB that failed to get converted, typically in wermuth.
# - "--" as two ASCII hyphens is never right.
	! egrep '\\|\$$.*\$$| TUB |--' $(xml_output) # TeX left untranslated?

# https://www.crossref.org/schemas/crossref5.3.1.xsd
# https://www.crossref.org/schemas/common5.3.1.xsd
xsd = http://www.crossref.org/schema/deposit/crossref5.3.1.xsd
#
# https://stackoverflow.com/questions/17002324/xmllint-validate-an-xml-file-against-two-xsd-schemas-envelope-payload
# https://www.biglist.com/lists/lists.mulberrytech.com/jats-list/archives/201310/msg00018.html
# Crossref says it is necessary to download everything locally for xmllint.
# Not easy to make work.
validate v: $(xml_output)
	xmllint --noout --schema $(xsd) $<

force:

#  Uploading.
# Crossref's upload tool seems to work fine. It comes from here:
# https://www.crossref.org/education/member-setup/direct-deposit-xml/https-post
#
upload = java -jar crossref-upload-tool.jar
crossread-upload-tool-help cut-help:
	$(cut) --help
#
# Upload to production or test server:
crossref_real_host = doi.crossref.org
crossref_test_host = test.crossref.org
#
# Of course the username and password are not committed to version control.
crossref_user = --user `cat crossref-user.txt`
#
# Don't do anything but run locally (which is not much):
chicken = #--dry-run
#
# Check progress at https://test.crossref.org; result also comes in email.
upload-test:
	$(upload) $(chicken) $(crossref_user) \
	  --host $(crossref_test_host) \
	   --metadata $(xml_output)
#
# It costs money to deposit a doi. Don't do it until you're sure.
# https://doi.crossref.org/
upload-real:
	checkme! $(upload) $(chicken) $(crossref_user) \
	  --host $(crossref_real_host) \
	  --metadata $(xml_output)
#
# If syntax is ok, get back a SUCCESS html doc.
# Then, log in to test.crossref.org resp. doi.crossref.org
# -> Submission administration
# -> Search (all fields can be left blank), or -> See System Queue
# -> can see status / get errors; should also get emailed back.
#
# The interfaces don't have any visible difference, unfortunately.
# Just have to check the url.
#
# test result mail From: CrossRef Query System <awsbounce@crossref.org>
# real result mail From: Crossref <admin@crossref.org>
