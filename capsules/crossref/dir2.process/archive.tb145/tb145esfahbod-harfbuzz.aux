\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The word \textit  {Typefit} in Libre Baskerville. \textit  {Top}: without OpenType shaping, glyphs are placed independently\unskip \nobreak  \thinskip  ---\thinskip  \ignorespaces the \textit  {Ty} pair is unkerned and \textit  {f\,i} appear as separate glyphs. \textit  {Bottom}: with shaping, \acro {GPOS} applies the \textit  {Ty} kern and \acro {GSUB} substitutes \textit  {fi} with a single ligature glyph.}}{23}{figure.2}\protected@file@percent }
\newlabel{fig:typefit}{{2}{23}{The word \textit {Typefit} in Libre Baskerville. \textit {Top}: without OpenType shaping, glyphs are placed independently\Dash the \textit {Ty} pair is unkerned and \textit {f\,i} appear as separate glyphs. \textit {Bottom}: with shaping, \acro {GPOS} applies the \textit {Ty} kern and \acro {GSUB} substitutes \textit {fi} with a single ligature glyph}{figure.2}{}}
