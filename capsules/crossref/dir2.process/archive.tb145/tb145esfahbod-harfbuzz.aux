\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The word \textit  {nasta\kern .05em{l\={\i }}q} ({\arabicfont \textdir TRT نستعلیق}, the name of the Nastaliq calligraphic style) rendered in a Nastaliq font. \textit  {Top}:\ without a dedicated text shaper, each character appears in its isolated form, unjoined and on a flat baseline. \textit  {Bottom}:\ with \HarfBuzz  , each letter is first substituted with its correct contextual form (initial, medial, or final) so that the word joins up properly, then positioned with the inter-glyph vertical offsets the font encodes, yielding the characteristic diagonal right-to-left cascade of the Nastaliq style. Each color identifies a distinct glyph cluster as output by the shaper.}}{22}{figure.1}\protected@file@percent }
\newlabel{fig:nastaliq}{{1}{22}{The word \textit {nasta\kern .05em{l\={\i }}q} (\textarabic {نستعلیق}, the name of the Nastaliq calligraphic style) rendered in a Nastaliq font. \textit {Top}:\ without a dedicated text shaper, each character appears in its isolated form, unjoined and on a flat baseline. \textit {Bottom}:\ with \HarfBuzz , each letter is first substituted with its correct contextual form (initial, medial, or final) so that the word joins up properly, then positioned with the inter-glyph vertical offsets the font encodes, yielding the characteristic diagonal right-to-left cascade of the Nastaliq style. Each color identifies a distinct glyph cluster as output by the shaper}{figure.1}{}}
