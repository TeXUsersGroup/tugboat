\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Some classic books about typography and type design in English. From left to right, top row:\endgraf \everypar {\hangindent =\parindent } \emph  {The~Geometry of Type} and \emph  {The Anatomy of Type} by~Stephen Coles, \emph  {Letter Fountain} by Joep Pohlen. \endgraf \noindent Middle row: \emph  {Inside Paragraphs} by Cyrus Highsmith, \emph  {Type Tricks} by Sofie Beier, \emph  {The Elements of Typographic Style} by Robert Bringhurst, \endgraf \noindent Bottom row: \emph  {Grid Systems in Graphic Design} by~Josef~Müller-Brockmann, \hskip \z@ plus\pagewd \break  \emph  {Counterpunch} by~Fred~Smeijers, \hskip \z@ plus\pagewd \break  \emph  {Thinking with Type} by Ellen Lupton. \unskip }}{329}{figure.2}\protected@file@percent }
\newlabel{fig:books-english}{{2}{329}{Some classic books about typography and type design in English. From left to right, top row:\endgraf \everypar {\hangindent =\parindent } \emph {The~Geometry of Type} and \emph {The Anatomy of Type} by~Stephen Coles, \emph {Letter Fountain} by Joep Pohlen. \endgraf \noindent Middle row: \emph {Inside Paragraphs} by Cyrus Highsmith, \emph {Type Tricks} by Sofie Beier, \emph {The Elements of Typographic Style} by Robert Bringhurst, \endgraf \noindent Bottom row: \emph {Grid Systems in Graphic Design} by~Josef~Müller-Brockmann, \newline \emph {Counterpunch} by~Fred~Smeijers, \newline \emph {Thinking with Type} by Ellen Lupton. \unskip }{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Famous typography books in French. \hskip \z@ plus\pagewd \break  From left to right, top row:\endgraf \everypar {\hangindent =\parindent } \emph  {Typographie, Guide Pratique} by Damien Gautier, \emph  {Les~Contrepoinçons} by Fred Smeijers, \emph  {Roger Excoffon et la Fonderie Olive} by Sandra Chamaret, Julien Ginest, and Sébastien Morlighem. \endgraf \noindent Bottom row: \emph  {Le Petit Manuel de Composition Typographique} by Muriel Paris, \emph  {Livre et Typographie} by Jan Tschichold, \emph  {Lexique des Règles Typographiques en Usage à l’Imprimerie Nationale} from the Imprimerie Nationale.}}{330}{figure.3}\protected@file@percent }
\newlabel{fig:books-french}{{3}{330}{Famous typography books in French. \newline From left to right, top row:\endgraf \everypar {\hangindent =\parindent } \emph {Typographie, Guide Pratique} by Damien Gautier, \emph {Les~Contrepoinçons} by Fred Smeijers, \emph {Roger Excoffon et la Fonderie Olive} by Sandra Chamaret, Julien Ginest, and Sébastien Morlighem. \endgraf \noindent Bottom row: \emph {Le Petit Manuel de Composition Typographique} by Muriel Paris, \emph {Livre et Typographie} by Jan Tschichold, \emph {Lexique des Règles Typographiques en Usage à l’Imprimerie Nationale} from the Imprimerie Nationale}{figure.3}{}}
