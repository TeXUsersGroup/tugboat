#!/usr/bin/env -S context --debug --once --forcecld
# $Id$

----------------------
--- Initialization ---
----------------------

-- Save some local copies of builtin functions to save typing.
local<const> insert, setmetatableindex = table.insert, table.setmetatableindex
local<const> assert, ipairs, pairs, type = assert, ipairs, pairs, type
local<const> exit = lua.setexitcode

-- Forbid creating new global variables.
global<const> * ---@diagnostic disable-line: global-element


---------------------------------
--- General-purpose Functions ---
---------------------------------

--- Prints a message to stderr.
---
--- @param msg string The message to print.
--- @param ... any The values to format into the message.
--- @return nil
local function stderr(msg, ...)
    io.stderr:write(msg:format(...), "\n")
end

--- Sets an upvalue of a function.
---
--- @param func function The function whose upvalue to set.
--- @param name string The name of the upvalue to set.
--- @param value any The value to set the upvalue to.
--- @return nil
local function set_upvalue(func, name, value)
    for n = 1, debug.getinfo(func).nups do
        local<const> nn, v = debug.getupvalue(func, n)
        if nn == name then
            debug.setupvalue(func, n, value)
            return
        end
    end
    assert(false, ("Upvalue %s not found"):format(name))
end

--- Gets an upvalue of a function.
---
--- @param func function The function whose upvalue to get.
--- @param name string The name of the upvalue to get.
--- @return any value The value of the upvalue.
local function get_upvalue(func, name)
    for i = 1, debug.getinfo(func).nups do
        local<const> j, v = debug.getupvalue(func, i)
        if j == name then
            return v
        end
    end
    assert(false, ("Upvalue %s not found"):format(name))
end

--- Convert a byte to a table of its bits.
---
--- @param byte integer
--- @return table<integer, boolean> bits The state of each bit.
local function bits(byte)
    assert(
        type(byte) == "number" and byte >= 0 and byte <= 255,
        "Expected a byte"
    )

    local<const> bits = {} --- @type table<integer, boolean>
    for bit = 0, 7 do
        bits[bit] = (byte >> (7 - bit)) % 2 == 1
    end
    return bits
end


---------------------
--- PDF Functions ---
---------------------

-- Make "pairs()" work for PDF objects.
do
    --- @type table<string, integer> Maps PDF object types to their type codes.
    local<const> types = table.swapped(pdfe.getfieldtypes())

    --- Gets an entry from a PDF object by its index number.
    --- @type table<string, fun(object: userdata, index: integer): (key: string|integer, type: integer, value: userdata)>
    local<const> getters = {
        ["pdfe.dictionary"] = pdfe.getfromdictionary,
        ["pdfe.array"] = function(object, index)
            return index, pdfe.getfromarray(object, index)
        end,
        ["pdfe.stream"] = pdfe.getfromstream,
    }

    --- A version of "pairs()" that works for PDF objects.
    ---
    --- @param object userdata The PDF object to iterate over.
    --- @return fun(): (key: string|integer, value: userdata) iter The iterator.
    local function pdf_pairs(object)
        local<const> getter = getters[pdfe.type(object)]
        return coroutine.wrap(function()
            for i = 1, #object do
                local key, type, value, _ = getter(object, i)
                if type == types.reference then
                    _, value, _ = pdfe.getfromreference(value)
                end
                coroutine.yield(key, value)
            end
        end)
    end

    -- Monkey-patch the PDF object types to use our custom "pairs()".
    local<const> registry = debug.getregistry()
    registry["pdfe.dictionary"].__pairs = pdf_pairs
    registry["pdfe.array"].__pairs = pdf_pairs
    registry["pdfe.stream"].__pairs = pdf_pairs
end

--- Parses CFF font data.
---
--- @param bytes string The raw bytes of the CFF font data.
--- @return table<string, table> font_data The parsed font data.
local function parse_cff(bytes)
    -- Open the CFF data as a new file-like stream.
    local<const> file = utilities.streams.openstring(bytes)

    -- Define the "font_data" table, which is is used both to configure
    -- "readers.cff()" and to store its output.
    local<const> font_data = {
        tables = { cff = { offset = 0 } },
        glyphs = {},
    }

    -- Parse the CFF font data.
    fonts.handlers.otf.readers.cff(file, font_data, { glyphs = true })

    -- Close the file and remove our input arguments from the output.
    utilities.streams.close(file)
    font_data.tables = nil

    -- By default, ConTeXt stores the glyphs in a consecutively-numbered array;
    -- however, we instead want a table indexed by the glyphs' CID indices.
    -- Below, we monkey-patch the code to store the CID indices in the "name"
    -- field of each glyph, so here we set that as the key for each entry.
    local<const> glyphs = {} --- @type table<string, table>
    for _, glyph in ipairs(font_data.glyphs) do
        glyphs[glyph.name] = glyph
        glyph.name = nil
    end
    font_data.glyphs = glyphs

    return font_data
end

do
    -- Required for us to be able to pass a file-like stream to "readers.cff()";
    -- without this, we would need to use a real file.
    directives.enable("fonts.streamreader")

    -- Force "readers.cff()" to always use the "readnoselect()" parsing function.
    -- This is required because only the "readnoselect()" function ultimately
    -- calls "readcharsets()".
    local<const> readnoselect = get_upvalue(
        fonts.handlers.otf.readers.cff, "readnoselect"
    )
    set_upvalue(
        fonts.handlers.otf.readers.cff, "readfdselect", readnoselect
    )

    -- Don't try to map CID indices to glyph names; instead, just store the
    -- CID indices directly in the "glyphs" table.
    local<const> readcharsets = get_upvalue(readnoselect, "readcharsets")
    set_upvalue(readnoselect, "readcharsets", function(f, data, dictionary)
        -- Save the original "strings" table.
        local<const> saved = data.strings

        -- Make the "strings" table just return whatever it's indexed with,
        -- so that CID indices just map to themselves.
        data.strings = setmetatableindex({}, "self")

        -- Call the original "readcharsets()" function and restore the original
        -- "strings" table.
        readcharsets(f, data, dictionary)
        data.strings = saved
    end)
end

--- Parse the /ToUnicode CMap from a font's stream.
---
--- Based off of the function from "lpdf-fnt.lua".
---
--- @param stream string The raw bytes of the /ToUnicode stream.
--- @return table<integer, integer> to_unicode The mapping from CID indices to Unicode codepoints.
local function parse_tounicode(stream)
    local<const> out = {} --- @type table<integer, integer>
    for s in stream:gmatch("beginbfrange%s*(.-)%s*endbfrange") do
        for first, last, offset in s:gmatch("<([^>]+)>%s*<([^>]+)>%s*<([^>]+)>") do
            local<const> first  = tonumber(first, 16)
            local<const> last   = tonumber(last, 16)
            local<const> offset = tonumber(offset, 16)

            for src = first, last do
                local<const> dst = src + offset
                out[src] = dst
            end
        end
    end

    for s in stream:gmatch("beginbfchar%s*(.-)%s*endbfchar") do
        for src, dst in s:gmatch("<([^>]+)>%s*<([^>]+)>") do
            local<const> src, dst = tonumber(src, 16), tonumber(dst, 16)
            out[src] = dst
        end
    end

    return out
end

--- Recursively expands a value from a PDF content stream.
---
--- @generic T
--- @param entry [string, `T`] A PDF content stream entry.
--- @return T value The expanded value.
local function _expand_pdf_contents_value(entry)
    local type <const>, value = table.unpack(entry)

    if type == "array" then
        for i, item in ipairs(value) do
            value[i] = _expand_pdf_contents_value(item)
        end
    elseif type == "dict" then
        for key, entry in pairs(value) do
            value[key] = _expand_pdf_contents_value(entry)
        end
    elseif type == "hex" then
        value = value:hextocharacters()
    elseif type == "name" then
        value = value
    elseif type == "number" then
        value = value
    else
        error("Unknown type: " .. type)
    end

    return value
end

--- Parses a PDF content stream into a list of operations.
---
--- @param contents string The raw bytes of the PDF content stream.
--- @return [..., string][] operations The list of operations.
local function parse_pdf_contents(contents)
    local<const> parsed = lpdf.epdf.parsecontent(contents, false)

    for _, operation in ipairs(parsed) do
        for i = 1, #operation - 1 do
            operation[i] = _expand_pdf_contents_value(operation[i])
        end
    end

    return parsed
end


------------------
--- Processing ---
------------------

-- Process the command-line arguments.
local<const> pdf_path = document.arguments.file
if not file.is_readable(pdf_path) then
    stderr(
        "Usage: %s --file={pdf-file} 2>&1 >/dev/null | column --table",
        document.arguments.fulljobname
    )
    stderr('Error: "%s" is not readable.', pdf_path)
    return exit(1)
end

-- Open the PDF file.
local<const> pdf = pdfe.open(pdf_path)
assert(pdfe.getstatus(pdf) == 0, "Failed to open PDF file")

-- Iterate over all the pages and validate the fonts.
local<const> missing_glyphs = {} --- @type table<string, any>[]

for page_number, page in ipairs(pdf.pages) do
    -- Get the fonts used on this page.
    local<const> page_fonts = page.Resources and page.Resources.Font
    if not page_fonts then goto next_page end

    -- Parse the fonts on the page.
    local<const> by_key = {} --- @type table<string, table>
    for font_key, font in pairs(page_fonts) do
        -- We only support Type 0 (composite) fonts.
        if font.Subtype ~= "Type0" then goto next_font end
        local<const> font_name = font.BaseFont

        -- Parse the /ToUnicode entry.
        local to_unicode = font.ToUnicode
        if not to_unicode then goto next_font end
        to_unicode = parse_tounicode(to_unicode(true))

        -- Parse the CFF font data.
        local<const> descendant = font.DescendantFonts[1]
        if descendant.Subtype ~= "CIDFontType0" then goto next_font end

        local<const> descriptor = descendant.FontDescriptor
        if not descriptor then goto next_font end

        local<const> font_file = descriptor.FontFile3
        if not font_file then goto next_font end

        local<const> cff_data = parse_cff(font_file(true))

        -- Parse the CID set.
        local cidset = descriptor.CIDSet
        local<const> cids = setmetatableindex({}, function() return false end)
        if cidset then
            cidset = cidset(true)
            for i, byte in ipairs(cidset:bytetable()) do
                for bit, value in pairs(bits(byte)) do
                    if value then
                        cids[(i - 1) * 8 + bit] = true
                    end
                end
            end
        end

        -- Save the font data for later use.
        by_key[font_key] = {
            dict = font,
            cff = cff_data,
            unicodes = to_unicode,
            name = font_name,
            cids = cids,
        }

        ::next_font::
    end

    -- Parse the page's contents.
    local<const> parsed = parse_pdf_contents(page.Contents(true))

    do
        -- Parse all text operations in the page stream.
        local font = nil
        for _, operation in ipairs(parsed) do
            local<const> operator = operation[#operation]
            if operator == "Tf" then -- select font
                font = operation[1]
            elseif operator == "Tj" or operator == "TJ" then -- show text
                assert(font, "Text operator used without setting a font")

                -- Get the full text string, concatenating if necessary.
                local string
                if operator == "Tj" then
                    string = operation[1]
                else
                    local<const> strings = {} --- @type string[]
                    for _, item in ipairs(operation[1]) do
                        if type(item) == "string" then
                            insert(strings, item)
                        end
                    end
                    string = table.concat(strings)
                end

                -- Get the font (meta)data.
                local<const> font = assert(by_key[font], "Font not found.")
                assert(font.dict.Encoding == "Identity-H", "Bad font encoding.")
                local<const> cff = font.cff.glyphs
                local<const> unicodes = font.unicodes
                local<const> cids = font.cids or setmetatableindex(
                    {}, function() return "?" end
                )

                -- Process all text in the string and make sure that we can find
                -- a matching glyph in all tables.
                for high, low in string:bytepairs() do
                    local<const> cid = high * 256 + low
                    local<const> cidset = cids[cid]
                    local<const> unicode, glyph = unicodes[cid], cff[cid]

                    local char = "missing"
                    if unicode then
                        local<const> chardata = characters.data[unicode]
                        if (not chardata) then
                            char = "unknown"
                        elseif chardata.description and
                               chardata.description:lower():match("private")
                        then
                            char = "private"
                        else
                            char = utf8.char(unicode)
                        end
                    end

                    -- If any of the tables are missing an entry for this CID,
                    -- then save it to print at the very end.
                    if (not unicode) or (not glyph) or (not cidset) then
                        insert(missing_glyphs, {
                            font = font.dict.BaseFont,
                            cid = cid,
                            codepoint = unicode and ("U+%04X"):format(unicode) or nil,
                            char = char,
                            cff = glyph ~= nil,
                            page = page_number,
                            cidset = cidset,
                        })
                    end
                end
            end
        end
    end

    ::next_page::
end

-- Show the results.
if #missing_glyphs == 0 then
    stderr("ok")
    return exit(0)
else
    table.sort(missing_glyphs, function(a, b)
        local<const> a_font = a.font:match("^[^+]+%+(.*)$") or a.font
        local<const> b_font = b.font:match("^[^+]+%+(.*)$") or b.font
        if a.page ~= b.page then
            return a.page < b.page
        elseif a_font ~= b_font then
            return a_font < b_font
        elseif a.char ~= b.char then
            return a.char < b.char
        else
            return a.cid < b.cid
        end
    end)

    stderr((table.tocsv(missing_glyphs, {
        preamble = true,
        fields = {
            "page", "font", "char", "cid", "codepoint", "cff", "cidset",
        },
        separator = "\t",
    }):gsub('"', "")))
    return exit(2)
end
