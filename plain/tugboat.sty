      \parindent \z@ \everypar={\hangindent 1pc }
      \parskip \z@skip
      \netaddrat
      \netaddrpercent
      \def\|{\unskip\hfil\break}%
      \def\\{\endgraf}%
      \def\net{\tt}%
      \def\phone{\rm Phone: } \rm
      \@signature}}
  }

